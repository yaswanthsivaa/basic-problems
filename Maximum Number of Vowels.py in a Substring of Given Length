s = input()
k = int(input())

count = 0

# Count vowels in the first window
for i in range(k):
    if s[i] in "aeiouAEIOU":
        count += 1

ans = count

# Slide the window
for i in range(k, len(s)):
    if s[i - k] in "aeiouAEIOU":
        count -= 1

    if s[i] in "aeiouAEIOU":
        count += 1

    ans = max(ans, count)

print(ans)
